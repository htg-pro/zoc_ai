{
  "name": "@zoc-studio/agent-runtime",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "Zoc AI Agent_Runtime \u2014 loopback Node process owning the AI SDK tool loop.",
  "main": "./src/main.ts",
  "exports": {
    ".": "./src/main.ts",
    "./policy": "./src/permissions/capability-policy.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node ./scripts/bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node --experimental-strip-types ./src/bin.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.103",
    "@ai-sdk/google": "3.0.101",
    "@ai-sdk/groq": "3.0.53",
    "@ai-sdk/openai": "3.0.88",
    "@ai-sdk/openai-compatible": "2.0.62",
    "@ai-sdk/xai": "3.0.111",
    "@zoc-studio/shared-types": "workspace:*",
    "ai": "6.0.235",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@yao-pkg/pkg": "6.9.0",
    "esbuild": "0.25.12",
    "eslint": "^9.12.0",
    "fast-check": "^3.23.2",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
